{
  "name": "tip-the-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pledge-to-make-it-happen shows: fans hold a spot with PayPal, an agent charges everyone and pays out only if the show tips.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "worker:dev": "wrangler dev --local --env check --port 8788",
    "lint": "eslint .",
    "test": "vitest run",
    "test:gpu": "playwright test",
    "spike": "node --env-file=.dev.vars --import tsx scripts/spikes/paypal-sandbox.ts",
    "worker:check": "node --import tsx scripts/worker-check.ts",
    "e2e:local": "playwright test -c playwright.e2e.config.ts",
    "sandbox:check": "node --env-file=.dev.vars --import tsx scripts/sandbox-check.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramenprotokol/tip-the-room.git"
  },
  "homepage": "https://github.com/ramenprotokol/tip-the-room",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@types/three": "0.170.0",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "jsqr": "^1.4.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "ag-grid-community": "36.2.0",
    "gsap": "3.12.5",
    "three": "0.170.0"
  }
}
